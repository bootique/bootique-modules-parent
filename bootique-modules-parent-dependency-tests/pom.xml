        <commons.lang.version>3.20.0</commons.lang.version>
        <commons.io.version>2.21.0</commons.io.version>
        <commons.codec.version>1.19.0</commons.codec.version>
    </properties>

    <!--
      Resolving these dependencies is the test: an upgrade to a version that was never published (a typo, a version
      that only exists in a staging repo, etc.) fails the build here instead of failing in a downstream module days
      later. Every version property of the parent POM should be exercised by at least one dependency below.
      -->
