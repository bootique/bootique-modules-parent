    <artifactId>bootique-modules-parent-dependency-tests</artifactId>

    <name>bootique-modules-parent-dependency-tests: Verifies dependency versions declared by the parent POM.</name>
    <description>
        A test-only module that is never published. It declares a dependency on every artifact whose version is
        managed by "bootique-modules-parent", so that a build fails if any of the declared versions does not exist.
    </description>

